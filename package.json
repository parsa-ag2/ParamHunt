{
  "name": "paramhunt",
  "version": "0.3.0",
  "private": true,
  "description": "ParamHunt — Chrome MV3 extension for browser-based security research: parameter discovery, HTTP analysis, DOM & JS inspection.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/sync-chrome.mjs",
    "sync:chrome": "node scripts/sync-chrome.mjs",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^21.0.4",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
